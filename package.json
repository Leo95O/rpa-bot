{
  "name": "logisticaview-rpa-bot",
  "version": "1.0.0",
  "description": "Bot RPA atendido (Playwright + CDP) para crear Insumos y registrar Compras en logisticaview",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test:e2e": "ts-node src/legacy/test-e2e-33-casos.ts",
    "test:bloque1": "ts-node src/e2e/aprovisionamiento.spec.ts",
    "test:bloque2": "ts-node src/e2e/consumibles.spec.ts",
    "test:bloque3": "ts-node src/e2e/traslados.spec.ts",
    "test:bloque4": "ts-node src/e2e/ajustes.spec.ts",
    "test:bloque5": "ts-node src/e2e/mrp.spec.ts",
    "test:bloque6": "ts-node src/e2e/canjes.spec.ts",
    "test:bloque7": "ts-node src/e2e/contraste.spec.ts",
    "test:bloque8": "ts-node src/e2e/ediciones.spec.ts",
    "test:suite": "ts-node src/e2e/suite.ts",
    "checklist": "ts-node src/e2e/checklist.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.20.2",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
